{
  "name": "app-calcio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prisma:generate": "prisma generate",
    "build": "npm run prisma:generate && next build",
    "db:deploy": "prisma migrate deploy",
    "start": "next start",
    "typecheck": "npm run prisma:generate && tsc --noEmit --pretty false",
    "lint": "eslint .",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:env": "node scripts/check-env.mjs",
    "doctor": "node scripts/check-env.mjs --soft && npm run modernization",
    "quality": "node scripts/quality-gate.mjs",
    "predeploy": "npm run check:env && npm run quality && npm run build",
    "predeploy:full": "npm run check:env && node scripts/quality-gate.mjs --with-build",
    "check:services": "node scripts/check-services.mjs",
    "test": "node scripts/run-domain-tests.mjs",
    "modernization": "npm run check:hygiene && npm run check:architecture && npm run check:services && npm test && npm run typecheck",
    "test:domain": "node scripts/run-domain-tests.mjs",
    "test:integration": "node scripts/run-integration-tests.mjs",
    "test:all": "npm run test:domain && npm run test:integration",
    "quality:integration": "npm run test:integration && npm run quality",
    "ci": "npm run modernization && npm run test:integration && npm run build",
    "check:hygiene": "node scripts/check-repo-hygiene.mjs",
    "cleanup:repo-index": "node scripts/cleanup-repo-index.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.4.2",
    "@prisma/client": "^7.4.2",
    "@vercel/blob": "^2.3.1",
    "lucide-react": "^0.577.0",
    "next": "16.1.6",
    "pg": "^8.20.0",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv": "^17.3.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "prisma": "^7.4.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
