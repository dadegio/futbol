{
  "name": "app-calcio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "db:deploy": "prisma migrate deploy",
    "start": "next start",
    "typecheck": "tsc --noEmit --pretty false",
    "lint": "eslint .",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:env": "node scripts/check-env.mjs",
    "doctor": "node scripts/check-env.mjs --soft && npm run check:architecture",
    "quality": "node scripts/quality-gate.mjs",
    "predeploy": "npm run check:env && npm run quality && npm run build",
    "predeploy:full": "npm run check:env && node scripts/quality-gate.mjs --with-build"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.4.2",
    "@prisma/client": "^7.4.2",
    "@vercel/blob": "^2.3.1",
    "lucide-react": "^0.577.0",
    "next": "16.1.6",
    "pg": "^8.20.0",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv": "^17.3.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "prisma": "^7.4.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
