datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

enum PlayoffFormat {
  SINGLE_ELIM
  TWO_LEG
}

enum Role {
  ADMIN
  LEAGUE_ADMIN
  CAPTAIN
  REFEREE
  CREATOR
}

enum MediaItemType {
  PHOTO
  VIDEO
  REEL
  HIGHLIGHT
  INTERVIEW
  BACKSTAGE
  OTHER
}

enum MediaItemStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  HIDDEN
  REJECTED
}

enum CreatorCoverageRole {
  PHOTO
  VIDEO
  BOTH
}

enum CreatorAssignmentRole {
  PHOTO
  VIDEO
}

enum MatchLifecycleStatus {
  SCHEDULED
  POSTPONED
  CANCELLED
}

enum MatchResultStatus {
  DRAFT
  FINAL
}

enum PlayerStatus {
  PENDING
  IN_REVIEW
  AUTHORIZED
  BLOCKED
  SUSPENDED
  RETIRED
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         Role
  teamId       String?  @unique
  refereeId    String?  @unique
  leagueId     String?
  team         Team?    @relation("TeamCaptain", fields: [teamId], references: [id], onDelete: SetNull)
  referee      Referee? @relation("RefereeAccount", fields: [refereeId], references: [id], onDelete: SetNull)
  adminLeague  League?  @relation("LeagueAdmins", fields: [leagueId], references: [id], onDelete: SetNull)
  creatorProfile CreatorProfile?
  uploadedMedia MediaItem[] @relation("MediaUploadedBy")
  auditLogs    AuditLog[] @relation("AuditLogActor")
  createdAt    DateTime @default(now())

  bookedMatches Match[] @relation("MatchBookedBy")

  @@index([leagueId])
}

model League {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  veoTeamId String?

  themeMode            String  @default("GENERIC")
  brandLogoUrl         String?
  brandCoverUrl        String?
  brandPrimaryColor    String?
  brandSecondaryColor  String?
  brandBackgroundColor String?

  cookieBannerEnabled Boolean @default(true)
  privacyPolicyUrl    String?
  cookiePolicyUrl     String?
  adsEnabled          Boolean @default(false)
  adProvider          String?
  adClientId          String?
  adHomeSlot          String?
  adLeagueSlot        String?

  playoffFormat    PlayoffFormat?
  playoffTeamCount Int?
  playoffSeeded    Boolean        @default(true)

  teams         Team[]
  matches       Match[]
  playoffSeries PlayoffSeries[]
  referees      Referee[]
  fields        Field[]
  admins        User[]          @relation("LeagueAdmins")
  sponsors      Sponsor[]
  creatorProfiles CreatorProfile[]
  mediaItems    MediaItem[]
  auditLogs     AuditLog[]
  teamFeePayments TeamFeePayment[]
}


model AuditLog {
  id            String   @id @default(cuid())
  leagueId      String?
  actorUserId   String?
  actorUsername String?
  actorRole     String?

  action     String
  entityType String
  entityId   String?
  summary    String?
  metadata   Json?

  createdAt DateTime @default(now())

  league League? @relation(fields: [leagueId], references: [id], onDelete: SetNull)
  actor  User?   @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([leagueId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action])
  @@index([entityType, entityId])
}


model Sponsor {
  id          String   @id @default(cuid())
  leagueId    String
  name        String
  category    String?
  description String?
  logoUrl     String?
  websiteUrl  String?
  instagramUrl String?
  phone       String?
  email       String?
  address     String?
  contactName String?
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  @@index([leagueId, active])
  @@index([leagueId, sortOrder])
  @@index([leagueId, active, sortOrder])
}


model CreatorProfile {
  id        String   @id @default(cuid())
  leagueId  String
  userId    String   @unique

  displayName  String
  roleLabel    String?
  avatarUrl    String?
  bio          String?
  instagramUrl String?
  tiktokUrl    String?
  youtubeUrl   String?
  email        String?
  phone        String?
  websiteUrl      String?
  primaryColor    String?
  preferredTeamId String?
  coverageRole    CreatorCoverageRole @default(PHOTO)
  weeklyAssignmentLimit Int @default(1)

  showEmail     Boolean @default(false)
  showInstagram Boolean @default(true)
  showTikTok    Boolean @default(true)
  showYoutube   Boolean @default(true)
  showPhone     Boolean @default(false)
  active        Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  league           League                   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  user             User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferredTeam    Team?                    @relation("CreatorPreferredTeam", fields: [preferredTeamId], references: [id], onDelete: SetNull)
  mediaItems       MediaItem[]
  matchAssignments CreatorMatchAssignment[]

  @@index([leagueId, active])
  @@index([preferredTeamId])
  @@index([displayName])
}

model MediaItem {
  id        String          @id @default(cuid())
  leagueId  String
  creatorId String?
  uploadedByUserId String?

  type      MediaItemType   @default(PHOTO)
  status    MediaItemStatus @default(PENDING_REVIEW)
  featured  Boolean         @default(false)

  title       String?
  caption     String?
  fileUrl     String
  thumbnailUrl String?
  socialUrl   String?

  matchId String?
  teamId  String?
  playerId String?
  round   Int?

  creditName      String?
  creditInstagram String?
  creditEmail     String?
  showCreditEmail Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  creator CreatorProfile? @relation(fields: [creatorId], references: [id], onDelete: SetNull)
  uploadedBy User? @relation("MediaUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  @@index([leagueId, status])
  @@index([leagueId, featured])
  @@index([leagueId, status, createdAt])
  @@index([leagueId, featured, createdAt])
  @@index([leagueId, type, status])
  @@index([creatorId])
  @@index([matchId])
  @@index([teamId])
  @@index([playerId])
  @@index([round])
}

model Team {
  id             String   @id @default(cuid())
  name           String
  badgeUrl       String?
  description    String?
  colorHex          String?
  secondaryColorHex String?
  activeInLeague Boolean  @default(true)
  createdAt      DateTime @default(now())

  leagueId String
  league   League @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  players      Player[]
  feePayments  TeamFeePayment[]
  sheetPlayers MatchSheetPlayer[]
  homeMatches  Match[]            @relation("HomeTeam")
  awayMatches  Match[]            @relation("AwayTeam")

  homeSeries PlayoffSeries[] @relation("SeriesHome")
  awaySeries PlayoffSeries[] @relation("SeriesAway")
  wonSeries  PlayoffSeries[] @relation("SeriesWinner")

  captain             User?            @relation("TeamCaptain")
  affiliatedReferees  Referee[]        @relation("RefereeTeamAffiliation")
  preferredByCreators CreatorProfile[] @relation("CreatorPreferredTeam")

  @@unique([leagueId, name])
  @@index([leagueId, activeInLeague])
}

model Player {
  id String @id @default(cuid())

  firstName String
  lastName  String
  number    Int
  position  String?
  photoUrl       String?
  photoZoom      Float  @default(1)
  photoPositionX Int    @default(50)
  photoPositionY Int    @default(50)
  isTeamCaptain Boolean @default(false)

  fiscalCode           String?
  birthDate            DateTime?
  documentSigned       Boolean      @default(false)
  signedAt             DateTime?
  privacyConsent       Boolean      @default(false)
  internalPhotoConsent Boolean      @default(false)
  publicPhotoConsent   Boolean      @default(false)
  mediaConsent         Boolean      @default(false)
  healthDeclaration    Boolean      @default(false)
  wildcardUsed         Boolean      @default(false)
  status               PlayerStatus @default(PENDING)
  statusNote           String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  stats        MatchPlayerStat[]
  sheetEntries MatchSheetPlayer[]
  mvpMatches   Match[]            @relation("MatchMvp")

  @@unique([teamId, number])
  @@index([teamId])
  @@index([teamId, status])
}

model Match {
  id            String    @id @default(cuid())
  leagueId      String
  round         Int
  date          DateTime?
  slotEnd       DateTime?
  slotWeekStart DateTime?

  venueKey       String?
  venueName      String?
  venueAddress   String?
  bookedByUserId String?
  bookedAt       DateTime?

  homeTeamId String
  awayTeamId String

  homeGoals Int?
  awayGoals Int?
  lifecycleStatus MatchLifecycleStatus @default(SCHEDULED)
  originalDate DateTime?
  resultStatus MatchResultStatus?
  finalizedAt DateTime?
  homeSheetConfirmed Boolean @default(false)
  awaySheetConfirmed Boolean @default(false)
  mvpPlayerId String?
  replayUrl String?
  highlightsUrl String?

  seriesId String?
  leg      Int?

  refereeCostCents      Int     @default(2000)
  refereeId             String?
  refereeManualOverride Boolean @default(false)

  createdAt DateTime @default(now())

  league   League         @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  homeTeam Team           @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam Team           @relation("AwayTeam", fields: [awayTeamId], references: [id])
  series   PlayoffSeries? @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  bookedBy User?          @relation("MatchBookedBy", fields: [bookedByUserId], references: [id], onDelete: SetNull)
  referee  Referee?       @relation(fields: [refereeId], references: [id], onDelete: SetNull)
  mvpPlayer Player?        @relation("MatchMvp", fields: [mvpPlayerId], references: [id], onDelete: SetNull)

  stats              MatchPlayerStat[]
  sheetPlayers       MatchSheetPlayer[]
  creatorAssignments CreatorMatchAssignment[]

  @@unique([venueKey, date])
  @@unique([seriesId, leg])
  @@index([leagueId, round])
  @@index([leagueId, date])
  @@index([leagueId, slotWeekStart])
  @@index([leagueId, seriesId, date])
  @@index([leagueId, seriesId, round])
  @@index([bookedByUserId])
  @@index([refereeId])
  @@index([seriesId])
  @@index([resultStatus])
  @@index([lifecycleStatus])
  @@index([mvpPlayerId])
}

model CreatorMatchAssignment {
  id        String   @id @default(cuid())
  creatorId String
  matchId   String
  role      CreatorAssignmentRole @default(PHOTO)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creator CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  match   Match          @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([creatorId, matchId])
  @@index([creatorId])
  @@index([matchId])
  @@index([matchId, role])
}

model Field {
  id        String   @id @default(cuid())
  leagueId  String
  name      String
  address   String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  league League      @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  slots  FieldSlot[]

  @@unique([leagueId, name])
  @@index([leagueId, active])
}

model FieldSlot {
  id              String @id @default(cuid())
  fieldId         String
  weekday         Int
  hour            Int
  minute          Int
  durationMinutes Int    @default(60)

  field Field @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([fieldId, weekday, hour, minute])
  @@index([fieldId, weekday])
}

model Referee {
  id        String   @id @default(cuid())
  leagueId  String
  name      String
  active    Boolean  @default(true)
  teamId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  league  League  @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  team    Team?   @relation("RefereeTeamAffiliation", fields: [teamId], references: [id], onDelete: SetNull)
  matches        Match[]
  availabilities RefereeAvailability[]
  account        User?   @relation("RefereeAccount")

  @@unique([leagueId, name])
  @@index([leagueId, active])
  @@index([teamId])
}

model RefereeAvailability {
  id        String @id @default(cuid())
  refereeId String
  weekday   Int
  hour      Int
  minute    Int

  referee Referee @relation(fields: [refereeId], references: [id], onDelete: Cascade)

  @@unique([refereeId, weekday, hour, minute])
  @@index([refereeId, weekday])
}

model MatchPlayerStat {
  id String @id @default(cuid())

  matchId  String
  playerId String

  goals   Int @default(0)
  assists Int @default(0)

  match  Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([matchId, playerId])
  @@index([playerId])
}

model MatchSheetPlayer {
  id String @id @default(cuid())

  matchId  String
  playerId String
  teamId   String

  createdAt DateTime @default(now())

  match  Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([matchId, playerId])
  @@index([playerId])
  @@index([teamId])
}


model TeamFeePayment {
  id          String   @id @default(cuid())
  leagueId    String
  teamId      String
  amountCents Int
  note        String?
  paidAt      DateTime @default(now())
  createdAt   DateTime @default(now())

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([leagueId, paidAt])
  @@index([teamId, paidAt])
}

model PlayoffSeries {
  id       String @id @default(cuid())
  leagueId String

  bracketRound Int
  position     Int

  homeTeamId String?
  awayTeamId String?

  homeSeed Int?
  awaySeed Int?

  penaltiesHome Int?
  penaltiesAway Int?

  winnerId String?

  feedsIntoSeriesId String?

  league    League         @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  homeTeam  Team?          @relation("SeriesHome", fields: [homeTeamId], references: [id])
  awayTeam  Team?          @relation("SeriesAway", fields: [awayTeamId], references: [id])
  winner    Team?          @relation("SeriesWinner", fields: [winnerId], references: [id])
  feedsInto PlayoffSeries? @relation("BracketProgression", fields: [feedsIntoSeriesId], references: [id])

  feederSeries PlayoffSeries[] @relation("BracketProgression")
  matches      Match[]

  @@unique([leagueId, bracketRound, position])
  @@index([leagueId])
}
