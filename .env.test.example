# Database PostgreSQL dedicato ai test di integrazione.
# Non usare il database di produzione. Il runner crea uno schema temporaneo
# torneo_it_* e lo elimina al termine.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Consigliato con Neon/connessioni pooled: URL diretta usata da Prisma Migrate.
# Se omessa, viene usata TEST_DATABASE_URL anche per le migration.
TEST_DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST:5432/DATABASE?sslmode=require"

# Solo per diagnosticare un test fallito: conserva lo schema temporaneo.
# KEEP_TEST_SCHEMA=1
