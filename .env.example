# Runtime database URL (pooled connection is fine for the app runtime).
DATABASE_URL="postgresql://USER:PASSWORD@POOLED_HOST:5432/DATABASE?sslmode=require"

# Direct connection recommended for Prisma Migrate during production deploys.
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST:5432/DATABASE?sslmode=require"

# Use long random values in real environments. Never commit the real secrets.
AUTH_SECRET="replace-with-at-least-32-random-characters"
SETUP_SECRET="replace-with-a-random-setup-secret"

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Public image storage (team logos, player photos, sponsor/admin images).
# Recommended for the zero-cost setup: Cloudinary Free.
PUBLIC_IMAGE_STORAGE_PROVIDER="cloudinary"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
BLOB_READ_WRITE_TOKEN=""

# Optional public integrations.
NEXT_PUBLIC_YOUTUBE_PLAYLIST_ID=""
NEXT_PUBLIC_YOUTUBE_PLAYLIST_URL=""
NEXT_PUBLIC_SPONSOR_NAME=""
NEXT_PUBLIC_SPONSOR_LOGO_URL="/sponsor-logo.png"
NEXT_PUBLIC_SPONSOR_URL="https://campingbar.it/"

# Media Center storage. Default keeps the current Vercel Blob behavior.
# Set to google_drive to store creator photo/video uploads in a Drive folder.
MEDIA_STORAGE_PROVIDER="vercel_blob"
GOOGLE_DRIVE_FOLDER_ID=""
GOOGLE_DRIVE_CLIENT_ID=""
GOOGLE_DRIVE_CLIENT_SECRET=""
GOOGLE_DRIVE_REFRESH_TOKEN=""

# Notifiche Web Push + promemoria automatici.
# Genera le chiavi con: npm run push:keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"

# Vercel Cron invia automaticamente: Authorization: Bearer <CRON_SECRET>
CRON_SECRET="replace-with-a-long-random-cron-secret"
